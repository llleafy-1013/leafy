# Node.js 22.13+；密钥可在本地管理端填写，.env 不应提交到 Git。
HOST=0.0.0.0
PORT=3000
DOUBAO_API_KEY=
# 填写火山方舟实际模型 ID 或已开通的 endpoint ID，不能使用展示名称
DOUBAO_MODEL=doubao-seed-2-1-lite-260915
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_API_KEY=
# 官方ID，模型权限及余额由供应商控制
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 公网模式要求管理员密码哈希；可由 scripts/prepare-cloud.js 生成。
NODE_ENV=development
# AUTH_REQUIRED=true
# ADMIN_PASSWORD_HASH=
DATA_DIR=data
# 公网持久卷使用 DATA_DIR=/data
# PUBLIC_ORIGIN=https://你的域名
